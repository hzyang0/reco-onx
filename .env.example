# Used when starting the JAR outside Docker Compose.
JDBC_URL=jdbc:mysql://localhost:3307/mini_reco?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai&characterEncoding=UTF-8&connectTimeout=2000&socketTimeout=1000
DB_USER=mini_reco
DB_PASSWORD=mini_reco
DB_POOL_SIZE=12
DB_CONNECTION_TIMEOUT_MS=2000
FLYWAY_LOCATIONS=filesystem:db/migration
REQUEST_TIMEOUT_MS=500
RECALL_FANOUT_TIMEOUT_MS=120
RECALL_FANOUT_PARALLELISM=3
RECALL_FANOUT_QUEUE_CAPACITY=64
LOG_LEVEL=INFO
AGENT_MODE=local
AGENT_SHORT_MEMORY_TTL_HOURS=24
AGENT_MAX_TOOL_STEPS=4
# Set all three values only when using an OpenAI-compatible function-calling model.
# AGENT_MODE=openai_compatible
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=replace-me

# LangGraph Agent service (the primary entry point when using Docker Compose).
AGENT_PLANNER=local
AGENT_SHORT_MEMORY_TTL_SECONDS=86400
# Set these three values only when the Python Agent should use an OpenAI-compatible
# model for intent planning. Without them, the deterministic local planner is used.
# AGENT_PLANNER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=replace-me
