# Used when starting the JAR outside Docker Compose.
JDBC_URL=jdbc:mysql://localhost:3307/mini_reco?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai&characterEncoding=UTF-8&connectTimeout=2000&socketTimeout=1000
DB_USER=mini_reco
DB_PASSWORD=mini_reco
DB_POOL_SIZE=12
DB_CONNECTION_TIMEOUT_MS=2000
FLYWAY_LOCATIONS=filesystem:db/migration
REQUEST_TIMEOUT_MS=500
RECALL_FANOUT_TIMEOUT_MS=120
RECALL_FANOUT_PARALLELISM=3
RECALL_FANOUT_QUEUE_CAPACITY=64
LOG_LEVEL=INFO
